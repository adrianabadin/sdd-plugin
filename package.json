{
  "name": "sdd-plugin2",
  "version": "1.0.0",
  "description": "",
  "main": "dist/bootstrap/index.js",
  "exports": {
    ".": "./dist/bootstrap/index.js",
    "./tui": "./dist/tui.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run test:all",
    "test:verification": "npx tsx test-verification.ts",
    "test:focused": "npx tsx tests/background-model-refresh-coordinator.test.ts",
    "test:adapter": "npx tsx tests/opencode-model-catalog.adapter.test.ts",
    "test:trace": "npx tsx tests/model-refresh-trace-logger.test.ts",
    "test:tui": "npx tsx tests/tui-registration.test.ts && npx tsx tests/tui-navigation.test.ts && npx tsx tests/tui-catalog-view.test.ts",
    "test:tui:bun": "bun tests/tui-bun-renderer.test.ts",
    "test:exports": "npx tsx tests/root-package-exports.test.ts",
    "test:typecheck:strict": "npx tsc --project tsconfig.test.json --noEmit",
    "test:all": "npm run test:verification && npm run test:focused && npm run test:adapter && npm run test:trace && npm run test:tui && npm run test:exports && npm run test:typecheck:strict",
    "trace:tail": "node -e \"const fs=require('fs'),os=require('os'),path=require('path');const p=process.env.SDD_PLUGIN_TRACE_PATH||path.join(os.homedir(),'.cache','sdd-plugin','model-refresh.log');try{const lines=fs.readFileSync(p,'utf8').trimEnd().split('\\n');for(const l of lines.slice(-50))process.stdout.write(l+'\\n');}catch(e){console.error('no trace yet:',e.message);}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianabadin/sdd-plugin.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/adrianabadin/sdd-plugin/issues"
  },
  "homepage": "https://github.com/adrianabadin/sdd-plugin#readme",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.17.11"
  },
  "devDependencies": {
    "@opentui/core": "^0.4.5",
    "@opentui/keymap": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "@types/node": "^20.17.0",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.9.0",
    "@prisma/client": "^7.8.0",
    "prisma": "^7.8.0",
    "solid-js": "1.9.12"
  }
}
