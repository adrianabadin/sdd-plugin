{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "strict": true,
    "skipLibCheck": false,
    "noImplicitAny": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force"
  },
  "include": [
    "tests/tui-registration.test.ts",
    "tests/tui-navigation.test.ts",
    "tests/tui-bun-renderer.test.ts",
    "tests/root-package-exports.test.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": ["src/index.ts"]
}
