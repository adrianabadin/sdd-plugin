{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "strict": true,
    "skipLibCheck": false,
    "noImplicitAny": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force"
  },
  "include": [
    "tests/tui-registration.test.ts",
    "tests/tui-navigation.test.ts",
    "tests/tui-bun-renderer.test.ts",
    "tests/tui-quarantine-overlay.test.ts",
    "tests/tui-subscription-editing.test.ts",
    "tests/root-package-exports.test.ts",
    "tests/model-route-grammar.test.ts",
    "tests/model-route-resolver.test.ts",
    "tests/model-route-query-port.test.ts",
    "tests/model-route-host-naming.test.ts",
    "tests/bootstrap-clean-startup.test.ts",
    "tests/model-route-disk-generator.test.ts",
    "tests/model-route-cli.test.ts",
    "tests/model-route-canary-readiness.test.ts",
    "tests/model-route-real-host-canary.integration.ts",
    "tests/model-route-quarantine.test.ts",
    "tests/model-route-audit.test.ts",
    "tests/model-route-task-hook.test.ts",
    "tests/model-route-routing-e2e.test.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": ["src/index.ts"]
}
